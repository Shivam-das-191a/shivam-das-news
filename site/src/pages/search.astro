---
import Base from '../layouts/Base.astro';
---
<Base title="Search" path="/search/" pageType="search" robots="noindex,follow">
  <h1>Search</h1>
  <div id="search" style="margin-top:16px"></div>
  <noscript><p class="meta">Search needs JavaScript. Browse the categories from the menu instead.</p></noscript>
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet">
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      if (window.PagefindUI) { var ui = new PagefindUI({ element: '#search', showSubResults: true, resetStyles: false }); var q = new URLSearchParams(location.search).get('q'); if (q) ui.triggerSearch(q); }
      else document.getElementById('search').textContent = 'Search index is built after the site build (npm run build).';
    });
  </script>
</Base>
